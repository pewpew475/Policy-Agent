# Insurance AI Assistant - Comprehensive .gitignore for Hackathon

# ================================
# 🚨 CRITICAL: ENVIRONMENT & SECRETS
# ================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
python-backend/.env
python-backend/.env.*

# API Keys and Secrets (NEVER COMMIT THESE!)
**/api_keys.txt
**/secrets.json
**/*secret*
**/*key*
**/*token*

# ================================
# NEXT.JS FRONTEND
# ================================
# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Next.js build output
/.next/
/out/
/build
dist/

# Testing
/coverage
.nyc_output

# ESLint cache
.eslintcache

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Temporary folders
tmp/
temp/

# ================================
# PYTHON BACKEND
# ================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
python-backend/venv/
python-backend/env/

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# ================================
# DATABASE & STORAGE
# ================================
# SQLite databases
*.db
*.sqlite
*.sqlite3
insurance_ai.db
python-backend/*.db
python-backend/*.sqlite*

# Uploaded files and documents
uploads/
documents/
temp_files/
processed_files/
python-backend/uploads/
python-backend/documents/
python-backend/temp_files/

# ================================
# LOGS & MONITORING
# ================================
# Log files
*.log
logs/
python-backend/logs/
*.log.*

# ================================
# DEVELOPMENT TOOLS
# ================================
# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# Windows
*.lnk

# ================================
# DEPLOYMENT & CLOUD
# ================================
# Vercel
.vercel

# Railway
.railway/

# Heroku
.heroku/

# Docker
.dockerignore
Dockerfile.prod

# ================================
# HACKATHON SPECIFIC
# ================================
# Demo files (keep originals, ignore copies)
**/demo_copy.*
**/test_copy.*
**/backup_*

# Large test documents (keep small samples only)
**/*_large.*
**/*_big.*
**/sample_documents/large/

# Competition sensitive files
submission/
presentation/private/

# ================================
# AI & ML MODELS
# ================================
# Model files (usually large)
*.pkl
*.joblib
*.h5
*.hdf5
models/
checkpoints/

# ================================
# CACHE & TEMPORARY FILES
# ================================
# Cache directories
.cache/
.parcel-cache/
.next/cache/

# Temporary files
*.tmp
*.temp
.tmp/
.temp/
